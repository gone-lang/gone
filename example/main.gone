//go:build ignore

// go:build ignore 让 `go build ./...` 跳过这个文件(example/ 里与 main.go 同名函数会冲突),
// 想运行它请显式指定文件名(命令行文件模式不看构建约束):
//
//	cd example && go run main.gone

package main

import (
	"fmt"
	"os"
)

func main() {
	body, !err := readSelf()
	fmt.Println("main.go content")
	fmt.Println(body)
}

func readSelf() (content string, err error) {
	body, !err := os.ReadFile("main.go")
	content = string(body)
	return
}
