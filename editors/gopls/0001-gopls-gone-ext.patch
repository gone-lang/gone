+// IsGoFile reports whether path names a Go source file, according to the
+// go/build package of the toolchain gopls was built with. Building gopls with
+// the gone toolchain (whose go/build also accepts ".gone") makes ".gone" files
+// Go source files everywhere gopls needs to know: file kinds, parsing, package
+// loading, and directory scans.
+func IsGoFile(path string) bool {
+	return build.IsGoFile(path)
+}
+
+// IsTestGoFile reports whether path names a Go test source file.
+func IsTestGoFile(path string) bool {
+	return build.IsTestGoFile(path)
+}
