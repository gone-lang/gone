 // errSugarOp reports the unary '!' operation and its operand name if x is a
 // candidate for the !err sugar, i.e. x has the form '!name'. Otherwise both
@@ -143,5 +147,29 @@
 	if len(names) == 0 {
 		return list
 	}
+	// The implicit error check returns from the enclosing function, so the
+	// function must have somewhere to return to: either no results at all or
+	// only named ones. go/types reports the same error at the same position,
+	// so that editors do not stay silent about a program that cannot build.
+	if !errSugarResultsOK(p.errSugarResults) {
+		p.syntaxErrorAt(pos, missingErrSugarResults)
+	}
 	return append(list, newErrCheck(names, pos))
 }
+
+// missingErrSugarResults is the error reported when the !err sugar is used in a
+// function with unnamed results.
+const missingErrSugarResults = "!err sugar requires named results (write func f() (s string, err error))"
+
+// errSugarResultsOK reports whether the implicit error check of the !err sugar
+// may return from a function with the given result list. A bare return
+// statement is valid for a function without results and for one whose results
+// are all named (including blank names).
+func errSugarResultsOK(results []*Field) bool {
+	for _, f := range results {
+		if f.Name == nil {
+			return false
+		}
+	}
+	return true
+}
