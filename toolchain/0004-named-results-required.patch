diff --git a/src/go/types/errsugar.go b/src/go/types/errsugar.go
--- a/src/go/types/errsugar.go
+++ b/src/go/types/errsugar.go
@@ -77,6 +77,26 @@
 	return lhs, sugar
 }
 
+// checkErrSugarResults reports an error if the enclosing function has unnamed
+// results, because the implicit error check of the !err sugar ends in a bare
+// return statement. cmd/compile reports the same error at the same position, so
+// that a program the compiler rejects is not silently accepted by tools built
+// on go/types (go vet, gopls).
+func (check *Checker) checkErrSugarResults(sugar []ast.Expr) {
+	if len(sugar) == 0 || check.sig == nil {
+		return
+	}
+	// A function without results has no result list to check.
+	if results := check.sig.Results(); results != nil {
+		for _, res := range results.vars {
+			if res.name == "" {
+				check.error(sugar[0], BadDecl, "!err sugar requires named results (write func f() (s string, err error))")
+				return
+			}
+		}
+	}
+}
+
