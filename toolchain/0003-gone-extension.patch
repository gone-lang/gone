+// goFileExts lists the name extensions that are treated as Go source files.
+// The gone toolchain adds ".gone" to the standard ".go", so that a package may
+// be written in .gone files and built directly by the go command.
+var goFileExts = []string{".go", ".gone"}
+
+// IsGoFile and IsTestGoFile are the single source of truth for which names the
+// gone toolchain treats as Go source files; callers outside go/build (cmd/go,
+// cmd/gofmt) should use them rather than testing suffixes themselves.
+
+// IsGoFile reports whether name is the name of a Go source file, that is,
+// whether it has one of the extensions listed in goFileExts.
+func IsGoFile(name string) bool {
+	for _, ext := range goFileExts {
+		if strings.HasSuffix(name, ext) {
+			return true
+		}
+	}
+	return false
+}
+
+// IsTestGoFile reports whether name is the name of a Go test source file,
+// e.g. "x_test.go" or (in the gone toolchain) "x_test.gone".
+func IsTestGoFile(name string) bool {
+	return strings.HasSuffix(name, "_test.go") || strings.HasSuffix(name, "_test.gone")
+}
